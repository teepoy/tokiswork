# OAuth Configuration for tokiswork-gradio-oauth
# Copy this to .env and fill in your OAuth provider details

# OAuth Provider Authorization Endpoint
# This is where users are redirected to authorize access
OAUTH_PROVIDER_URL=https://your-oauth-provider.com/oauth/authorize

# OAuth Provider Token Endpoint
# This is where we exchange the authorization code for an access token
OAUTH_TOKEN_ENDPOINT=https://your-oauth-provider.com/oauth/token

# OAuth Client ID (from your OAuth provider)
OAUTH_CLIENT_ID=your_client_id_here

# OAuth Client Secret (from your OAuth provider - KEEP SECRET!)
OAUTH_CLIENT_SECRET=your_client_secret_here

# Optional: Callback path for OAuth redirect
# Default: /auth/callback
# OAUTH_REDIRECT_PATH=/auth/callback

# Optional: OAuth scopes to request
# Default: openid email profile
# OAUTH_SCOPES=openid email profile

# Optional: Session secret for app (for HTTPS/production use)
# If not set, a random one is generated (sessions won't persist across restarts)
# SESSION_SECRET=your_session_secret_here

# Optional: Gradio server configuration
# GRADIO_SERVER_NAME=127.0.0.1
# GRADIO_SERVER_PORT=7860
